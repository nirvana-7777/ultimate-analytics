# Copy to .env and fill in. NEVER commit .env (it holds the ingest token and
# the DB password). docker-compose.yml reads this file for every service
# except caddy/grafana/prometheus (which need none of it).

# Postgres DSN. The password must match secrets/pg_password (compose mounts
# that file into postgres; the DSN carries it for the app).
ANALYTICS_DATABASE_URL=postgresql://analytics:CHANGE_ME@postgres:5432/analytics

# Bearer token the backends present on POST /ingest. REQUIRED in production.
# (Set ANALYTICS_AUTH_DISABLED=1 only for local dev.)
ANALYTICS_AUTH_TOKEN=

# --- tuning (defaults shown; delete what you don't override) ---
ANALYTICS_SESSION_GAP_S=120
ANALYTICS_REBUILD_WINDOW_S=900
ANALYTICS_MAX_EVENTS_AGE_S=3600
ANALYTICS_ROLLUP_BUCKET_CAP=720
ANALYTICS_RAW_RETENTION_DAYS=14
ANALYTICS_QUARANTINE_RETENTION_DAYS=7
ANALYTICS_WORKER_TICK_S=60

# --- round-3 bounds ---
# Requests with more events than this are rejected whole (413).
ANALYTICS_MAX_EVENTS_PER_BATCH=5000
# Worker pool statement budget (gap histogram day-scans need more than the
# ingester's 1.5 s).
ANALYTICS_WORKER_STATEMENT_TIMEOUT_MS=60000
# Partition DDL gives up after this long instead of queueing behind ingest.
ANALYTICS_DDL_LOCK_TIMEOUT_MS=3000
# ts more than this far in the future is quarantined as poison, not skew.
ANALYTICS_TS_MAX_FUTURE_S=86400

# --- round-4 ---
# Comma-separated allowlist: event_type values outside it are counted under
# the single metric label "other" (cardinality bound); the real type stays
# in events.raw. Extend when a new sender ships (e.g. media proxy).
ANALYTICS_KNOWN_EVENT_TYPES=manifest_request
# Per-session rows carry client_ip (personal data) — deleted after this many
# days. Aggregates (rollup_1m, gap_histogram) keep forever.
ANALYTICS_SESSIONS_RETENTION_DAYS=90

ANALYTICS_LOG_LEVEL=info
