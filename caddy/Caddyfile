# For local testing without DNS: change the site addresses to `localhost`
# (Caddy will use its internal CA) or add hosts entries pointing here.
analytics.example.com {
	# Backstop only. A 429 is a dropped batch on the backend (doc §2,
	# at-most-once, no retry). Tightening this = choosing to lose data.
	# Tune alongside ANALYTICS_SESSION_GAP_S.
	rate_limit {
		zone ingest {
			key {remote_host}
			events 120
			window 1m
		}
	}
	reverse_proxy ingester:8000
}

grafana.example.com {
	reverse_proxy grafana:3000
}
