  {
   "id": 10,
   "title": "Delivery mix",
   "description": "How much traffic is redirect vs proxied vs error \u2014 explains duration coverage. '' rows are events with unknown delivery (future senders).",
   "type": "piechart",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
