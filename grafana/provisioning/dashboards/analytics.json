   "description": "Query param from the client, NOT geolocation (doc \u00a73). Split by delivery.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
