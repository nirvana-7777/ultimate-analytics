 "tags": [
  "analytics",
  "provisioned"
 ],
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "timezone": "browser",
 "title": "Streaming Analytics",
 "uid": "streaming-analytics",
 "version": 1,
 "panels": [
  {
   "id": 1,
   "title": "Current watched channels",
   "description": "Active in last ~3 min, from the sessions table (fresh, no rollup lag). Split by delivery \u2014 redirect rows are session starts, proxied rows are ongoing sessions.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT delivery, provider, content_type, channel_id, count(*) AS active\nFROM sessions\nWHERE closed = false OR ended_at > extract(epoch FROM now())::bigint - 180\nGROUP BY 1,2,3,4\nORDER BY 5 DESC\nLIMIT 20",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 2,
   "title": "Views by delivery",
   "description": "Redirect = manifest-request events (excluding http_status >= 400); proxied = sessions started. Never blended into a single number.",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(bucket, $__interval), delivery, sum(views) AS views\nFROM rollup_1m\nWHERE $__timeFilter(bucket)\nGROUP BY 1,2\nORDER BY 1",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "interval": "1m"
  },
  {
   "id": 3,
   "title": "Viewer-seconds (proxied-derived)",
   "description": "Redirect sessions contribute 0 \u2014 no heartbeat (doc \u00a74). Attributed at session start: long sessions spike their start bucket; the companion rate panel below corrects that.",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawSql": "SELECT date_trunc('minute', to_timestamp(started_at)) AS \"time\",\n       sum(duration_s) AS viewer_seconds\nFROM sessions\nWHERE delivery = 'proxied' AND $__unixEpochFilter(started_at)\nGROUP BY 1\nORDER BY 1",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 4,
   "title": "Concurrent proxied viewers (approx)",
   "description": "Sessions alive at each point in time (started_at <= t < started_at + duration_s), counted per step. Sessions without duration_s (still open) are not counted, so the right edge dips; sessions longer than 24h are ignored.",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawSql": "SELECT g AS \"time\", count(s.started_at) AS concurrent\nFROM generate_series(\n       $__timeFrom()::timestamptz,\n       $__timeTo()::timestamptz,\n       make_interval(secs => GREATEST(60, $__interval_ms / 1000))\n     ) AS g\nLEFT JOIN sessions s\n  ON s.delivery = 'proxied'\n AND s.started_at > extract(epoch FROM $__timeFrom()::timestamptz) - 86400\n AND s.started_at <= extract(epoch FROM g)\n AND s.started_at + s.duration_s > extract(epoch FROM g)\nGROUP BY 1\nORDER BY 1",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "interval": "1m"
  },
  {
   "id": 5,
   "title": "Top channels",
   "description": "Split by delivery; delivery='error' rows excluded from most-watched.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT delivery, provider, channel_id, sum(views) AS views\nFROM rollup_1m\nWHERE $__timeFilter(bucket) AND delivery <> 'error'\nGROUP BY 1,2,3\nORDER BY 4 DESC\nLIMIT 20",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 6,
   "title": "Top providers",
   "description": "Split by delivery.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "postgres"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "format": "table",
     "rawSql": "SELECT delivery, provider, sum(views) AS views\nFROM rollup_1m\nWHERE $__timeFilter(bucket) AND delivery <> 'error'\nGROUP BY 1,2\nORDER BY 3 DESC\nLIMIT 20",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "postgres"
     },
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 7,
