     "rawSql": "SELECT delivery, sum(events) AS events\nFROM rollup_1m\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 2 DESC",
     "datasource": {
      "type": "grafana-postgresql-datasource",
